# Copy to .env and adjust as needed.

# Any SQLAlchemy database URL. Defaults to a local SQLite file.
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/insightflow
DATABASE_URL=sqlite:///./insightflow.db

# Optional: set to enable LLM-powered agents. Leave empty to use heuristics.
GEMINI_API_KEY=
# Primary model, with an automatic fallback if the primary is unavailable.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Comma-separated allowed browser origins for CORS. "*" allows any.
# In production set to your Netlify site, e.g. https://your-site.netlify.app
CORS_ORIGINS=*
